{
  "name": "kort",
  "productName": "KORT",
  "version": "1.0.0",
  "private": true,
  "description": "KORT для Windows: работает и без связи с сервером",
  "author": "KORT",
  "main": "dist/main.js",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "build": "tsc -p .",
    "web": "node scripts/prepare-web.mjs",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && pnpm web && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  }
}
