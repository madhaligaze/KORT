# Фронт KORT (Next.js). На Railway - переменные сервиса фронта.

# Адрес API KORT без хвостового слэша. Браузер ходит только на фронт, фронт
# проксирует /api/backend/* сюда (src/app/api/backend/[...path]/route.ts).
API_URL=https://kortbackend-production.up.railway.app

# Общий секрет с API. Прокси ставит его заголовком x-proxy-auth, и только по
# нему API верит присланному адресу человека (x-client-ip). То же значение - в
# переменной PROXY_SHARED_SECRET бэкенда. Без него прямой запрос к открытому
# API подделывал бы адрес в журнале и обходил ограничитель перебора.
PROXY_SHARED_SECRET=

# PORT и HOSTNAME задаёт Dockerfile / Railway, трогать не нужно.
